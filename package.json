{
  "name": "portal-calidad",
  "private": true,
  "version": "1.0.0",
  "description": "Portal de Calidad Positivo S+ · Prevención de Fraudes Bradescard. Reemplaza los libros de Excel de cédulas, reincidencias y actas.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node server/server.mjs",
    "start:red": "node server/server.mjs --red",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "extraer": "python scripts/extraer_excel.py"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
